{
  "name": "cloudflarest-management-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "vite --mode mock --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:browser:fixes": "node tests/browser-fixes.mjs"
  },
  "dependencies": { "vue": "3.5.42", "vue-router": "4.6.4" },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@types/node": "22.19.15",
    "playwright": "1.60.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.8",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "@babel/helper-string-parser": "7.29.7",
    "@babel/types": "7.29.8",
    "@babel/parser": "7.29.8"
  }
}
